# =============================================================================
# JUNTO SMS NOTIFICATION SYSTEM - Environment Configuration
# =============================================================================

# -----------------------------------------
# Application Configuration
# -----------------------------------------
NEXT_PUBLIC_APP_URL=https://your-domain.com
NODE_ENV=production

# -----------------------------------------
# Supabase Configuration
# -----------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# -----------------------------------------
# Twilio SMS Configuration (REQUIRED)
# -----------------------------------------
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# -----------------------------------------
# Security & Cron Configuration
# -----------------------------------------
CRON_SECRET=your_secure_cron_secret_key

# -----------------------------------------
# Optional: Google Maps Integration
# -----------------------------------------
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# -----------------------------------------
# Production Notes:
# -----------------------------------------
# 1. Replace ALL placeholder values with real credentials
# 2. Keep credentials secure - never commit .env.local to version control
# 3. Use different values for staging/production environments
# 4. Generate strong CRON_SECRET for endpoint protection
# 5. Verify Twilio phone number is SMS-enabled and verified
# 6. Configure webhook URLs in Twilio Console:
#    - Status Callback: https://your-domain.com/api/twilio/webhook/status
#    - Incoming SMS: https://your-domain.com/api/twilio/webhook/incoming 