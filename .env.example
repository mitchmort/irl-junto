# ==========================================
# ENVIRONMENT VARIABLES TEMPLATE
# ==========================================
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local or any file with real credentials

# Supabase Configuration
# Get these from: https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key  # Optional, for server-side operations

# Twilio Configuration (KEEP THESE SECRET!)
# Get these from: https://console.twilio.com
# Account SID format: ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx (34 chars starting with AC)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Auth Token: Keep this extremely secure, it provides full account access
TWILIO_AUTH_TOKEN=your_32_character_auth_token
# Phone number must be in E.164 format: +1XXXXXXXXXX
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# Application Configuration
# For local development, use http://localhost:3000
# For production, use your actual domain (https://yourdomain.com)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Security Configuration
# Generate a random string for webhook security: openssl rand -hex 32
CRON_SECRET=generate_a_random_secret_key_here

# Optional: Database URL for direct connections
# Format: postgresql://user:password@host:port/database
DATABASE_URL=your_database_url

# Google Maps Configuration (if using location features)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key